#!/usr/bin/env bash
# Reference (correct) version of max.
# Usage: max A B   -- prints the larger of two integers.
# On bad input: prints "usage: max A B" to stderr and exits 1.
is_int() { [[ "$1" =~ ^-?[0-9]+$ ]]; }
if [ $# -ne 2 ] || ! is_int "$1" || ! is_int "$2"; then
    echo "usage: max A B" >&2
    exit 1
fi
if [ "$1" -ge "$2" ]; then
    echo "$1"
else
    echo "$2"
fi
exit 0
